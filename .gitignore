# ROS/catkin generated directories
build/
devel/
install/
log/
logs/

# Python/cache artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Runtime data and large recordings
*.bag
*.log
*.db3
*.mcap

# Nested repository metadata from copied package snapshots
PC_catkin_src/**/.git/
PI_catkin_src/**/.git/

# Daisy-specific hardware mapping; keep local/remote patch out of shared sync
DAISY_catkin_src/vpa_robot_interface/scripts/wheel_driver.py

# Runtime robot display state, including initial battery levels
PC_catkin_src/vpa_duckierace/config/robot_display_config.yaml

# Local tooling metadata
.agents/
.codex/
.git_real/
